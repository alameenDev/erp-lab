{
  "name": "digital-lab-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Independent offline Digital Lab for Windows",
  "author": "Digital Lab",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "stage": "node scripts/stage.cjs",
    "smoke": "electron . --smoke-test",
    "build:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {"yauzl": "3.2.0", "yazl": "3.3.1"},
  "devDependencies": {"electron": "44.9.0", "electron-builder": "26.15.3"},
  "build": {
    "appId": "com.digitallab.desktop.v1",
    "productName": "Digital Lab Desktop",
    "asar": true,
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "extraResources": [{"from": "bundle", "to": "bundle"}],
    "directories": {"output": "dist"},
    "win": {"target": "nsis", "icon": "assets/icon.ico", "signAndEditExecutable": false},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "deleteAppDataOnUninstall": false, "artifactName": "Digital-Lab-Desktop-Setup-${version}.${ext}"}
  }
}
