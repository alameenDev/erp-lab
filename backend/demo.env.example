# Private file OUTSIDE public_html. Do not copy the live .env here.
# Create a database AND a database user with privileges for that database only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_lab_demo
DB_USERNAME=erp_lab_demo
DB_PASSWORD=replace-with-dedicated-password
# Generate a DIFFERENT key: php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
APP_KEY=
